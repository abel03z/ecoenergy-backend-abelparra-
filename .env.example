# Copiar este archivo a .env y ajustar los valores según el entorno.
# cp .env.example .env

# sqlite (por defecto, no requiere motor externo) o mysql
DB_ENGINE=sqlite
DB_NAME=db.sqlite3

# Solo se usan si DB_ENGINE=mysql:
# DB_USER=
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=3306

# Recuperación de contraseña (código de 6 dígitos)
# Por defecto el correo se imprime en la consola del servidor.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Para SMTP real (EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend):
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=EcoEnergy <no-reply@tudominio.cl>
PASSWORD_RESET_CODE_TTL=300
# Solo demo sin correo: muestra el código en pantalla. Dejar en False.
PASSWORD_RESET_DEMO_MODE=False
